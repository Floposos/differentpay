{
  "manifest_version": 3,
  "name": "DifferentPay – Preise in Arbeitsstunden",
  "version": "1.0.0",
  "description": "Zeigt Preise auf Shopping-Seiten als Arbeitszeit an, die du dafür arbeiten musst.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DifferentPay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-hours": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Arbeitsstunden-Anzeige an/aus"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

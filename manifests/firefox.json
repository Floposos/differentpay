{
  "manifest_version": 2,
  "name": "DifferentPay – Preise in Arbeitsstunden",
  "version": "1.0.0",
  "description": "Zeigt Preise auf Shopping-Seiten als Arbeitszeit an, die du dafür arbeiten musst.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "DifferentPay",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "toggle-hours": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Arbeitsstunden-Anzeige an/aus"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "differentpay@differentpay.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
